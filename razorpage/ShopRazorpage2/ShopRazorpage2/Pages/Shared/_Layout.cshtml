<!DOCTYPE html>
<html lang="fa" dir="rtl">
<meta charset="utf-8" />

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - فروشگاه تیفانی </title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
        }

        
        /* Top Bar */
        .top-bar {
            background: #1a1a1a;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }

            .top-bar a {
                color: #fff;
                transition: color 0.3s;
            }

                .top-bar a:hover {
                    color: #ffc107;
                }

        /* Navbar Gradient + Center Text */
        .navbar {
            background: linear-gradient(90deg, #ff7eb3, #a05cff, #1e90ff);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .navbar-nav {
            text-align: center;
            width: 100%;
        }

            .navbar-nav .nav-item {
                margin: 0 10px;
            }

            .navbar-nav .nav-link {
                color: #fff;
                font-weight: 500;
                transition: color 0.3s, transform 0.2s;
            }

                .navbar-nav .nav-link:hover {
                    color: #ffc107;
                    transform: scale(1.05);
                }

        /* Center Logo */
        .navbar-brand {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            font-weight: 700;
        }

        /* Search Button */
        .navbar .btn-light {
            transition: background 0.3s, color 0.3s;
        }

            .navbar .btn-light:hover {
                background: #ffc107;
                color: #000;
            }

        .custom-footer {
            background-color: #0b2545; /* سرمه‌ای */
        }

    </style>
</head>

<body class="d-flex flex-column min-vh-100" style="background-color:#f3e5d0;">
    <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background-color:#0a2240;">
        <div class="container d-flex justify-content-between align-items-center">

            <!-- Toggle (سمت چپ برای موبایل) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu (وسط) -->
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav mb-2 mb-lg-0 text-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index"><i class="bi bi-house-door"></i> خانه</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/About"><i class="bi bi-info-circle"></i> درباره ما</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/FAQ"><i class="bi bi-question-circle"></i> سوالات متداول</a></li>
                    <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-page="/Specials"><i class="bi bi-star-fill"></i> فروش ویژه</a></li>

                    <!-- روی موبایل: Cart / Login / Register -->
                    <li class="nav-item d-lg-none mt-2">
                        <a class="nav-link" href="/Cart"><i class="bi bi-cart-fill"></i> سبد خرید</a>
                    </li>
                    <li class="nav-item d-lg-none">
                        <a class="nav-link" href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> ورود</a>
                    </li>
                    <li class="nav-item d-lg-none">
                        <a class="nav-link" href="/Account/Register"><i class="bi bi-person-plus-fill"></i> ثبت نام</a>
                    </li>
                </ul>
            </div>

            <!-- Logo سمت راست -->
            <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                <i class="bi bi-shop ms-2"></i> کیف و کفش تیفانی
            </a>



            <!-- روی دسکتاپ: Cart / Login / Register کنار لوگو -->
            <div class="d-none d-lg-flex align-items-center">
                <a href="/Cart" class="nav-link text-white fw-bold me-4">
                    <i class="bi bi-cart-fill"></i> سبد خرید
                </a>
                <a href="/Account/Login" class="nav-link text-white fw-bold me-4">
                    <i class="bi bi-box-arrow-in-right"></i> ورود
                </a>
                <a href="/Account/Register" class="nav-link text-white fw-bold me-4">
                    <i class="bi bi-person-plus-fill"></i> ثبت نام
                </a>
            </div>




        </div>
    </nav>
    <!-- دکمه افزودن محصول بالای سایت سمت چپ با گرادیانت سبز -->

    <a asp-page="/Products/Create" class="btn shadow d-flex align-items-center"
       style="top:80px; left:50px; position:fixed; padding: 12px 20px; border-radius:50px;
          font-size:1rem; z-index:1000;
          background: linear-gradient(135deg, #a8e6cf, #56c596);
          color:white; font-weight:bold; text-decoration:none;
          transition: transform 0.2s, box-shadow 0.2s;">
        <span style="font-size:1.3rem; margin-right:8px;">➕</span> افزودن محصول
    </a>

    <style>
        a.btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            text-decoration: none;
        }
    </style>
    <!-- 🔹 Main Content -->
    <main class="container my-4 flex-grow-1">
        @RenderBody()
    </main>

   
    <!-- 🔹 Footer -->
    <footer class="mt-auto py-5 text-white position-relative" style="background-color:#0a2240;">

        <!-- شبکه‌های اجتماعی (چسبیده به چپ) -->
        <div style="position: absolute; top: 3rem; left: 0; display: flex; gap: 0.75rem; padding-left: 7rem;">
            <a href="#" class="text-white fs-4"><i class="bi bi-facebook"></i></a>
            <a href="#" class="text-white fs-4"><i class="bi bi-instagram"></i></a>
            <a href="#" class="text-white fs-4"><i class="bi bi-telegram"></i></a>
            <a href="#" class="text-white fs-4"><i class="bi bi-whatsapp"></i></a>
        </div>

        <!-- نمادهای اعتماد (چسبیده به چپ و پایین‌تر) -->
        <div style="position: absolute; top: 11rem; left: 0; display: flex; gap: 2rem; padding-left: 12rem;">
            <img src="/images/emmad.png" alt="نماد اعتماد" class="rounded-3" style="height:100px; width:100px; object-fit:cover;">
            <img src="/images/نشان ملی.jpg" alt="نشان ملی ثبت" class="rounded-3" style="height:100px; width:100px; object-fit:cover;">
            <img src="/images/senf.webp" alt="پرداخت امن" class="rounded-3" style="height:100px; width:100px; object-fit:cover;">
        </div>

        <div class="container">
            <!-- متن فروشگاه من بالای خط -->
            <div class="text-center mb-3">
                <p class="fw-bold mb-2" style="font-size:1.3rem;">
                    <i class="bi bi-shop me-2"></i> کیف و کفش تیفانی
                </p>
            </div>

            <!-- خط سفید سراسری -->
            <hr class="border-white">

            <div class="row mt-3">
                <!-- شعب تیفانی (سمت راست) -->
                <div class="col-md-4 text-end">
                    <h5 class="fw-bold mb-3">شعب تیفانی:</h5>

                    <!-- شعبه اطلس مال -->
                    <p class="mb-3" style="white-space: nowrap;">
                        <span class="fw-bold">شعبه اطلس مال:  </span>
                        تهران - خیابان نیاوران - مجتمع اطلس مال - طبقه همکف واحد 200
                        <br>
                        شماره تماس: 26388362-021
                    </p>

                    <!-- شعبه باملند -->
                    <p class="mb-3" style="white-space: nowrap;">
                        <span class="fw-bold">شعبه باملند:   </span>
                        تهران - دریاچه چیتگر- مرکز خرید باملند - بلوک C - طبقه منفی یک واحد 37GB
                        <br>
                        شماره تماس: 44820182-021
                    </p>

                    <p class="mb-0" style="white-space: nowrap;">
                        <span class="fw-bold">شعبه تیراژه2:  </span>
                        تهران - خیابان مدنی - جنب مترو مدنی - مجتمع تیراژه 2 - طبقه همکف - واحد G44
                        <br>
                        شماره تماس: 77159980-021
                    </p>
                </div>

                

            <!-- کپی رایت -->
            <div class="text-center mt-4 ">
                <small>© @DateTime.Now.Year - تمام حقوق محفوظ است.</small>
            </div>
        </div>
    </footer>

    <!-- 🔹 Scripts -->
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
