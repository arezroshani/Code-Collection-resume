@page
@model ShopRazorpage2.Pages.IndexModel
@{
    ViewData["Title"] = "صفحه اصلی";
}

<div class="container py-5">

   



    <!-- Hero Section -->
    <div class="row align-items-center gy-5 mb-5 hero-section">
        <!-- متن -->
        <div class="col-lg-6 text-lg-end text-center d-flex flex-column justify-content-center">
            <h1 class="fw-bolder display-3 mb-3 text-dark hero-title">
                <span class="brand-gradient me-3">کیف و کفش تیفانی</span>
            </h1>
            <p class="fs-5 text-dark mb-4 hero-subtitle me-5 fw-bold" style="padding-top: 20px;">
                «استایل تو، داستان توست. با تیفانی روایتش کن.»
            </p>


            <div class="w-100 d-flex btn-right-wrap"  style="padding-top: 30px;">
                <div class="ms-auto d-flex gap-3 me-4">
                    <a asp-page="/Products/Index" class="btn btn-primary btn-lg px-5 py-3 shadow-sm ">
                        <i class="bi bi-bag-check me-2"></i> مشاهده محصولات
                    </a>
                    <a href="#categories" class="btn btn-outline-secondary btn-lg px-5 py-3 ">
                        <i class="bi bi-grid-3x3-gap me-2"></i> دسته‌بندی‌ها
                    </a>
                </div>
            </div>
        </div>

        <!-- تصویر -->
        <div class="col-lg-6 text-center">
            <div class="position-relative">
                <img src="/images/tifany.png" alt="فروشگاه تیفانی" class="img-fluid rounded-4 shadow-lg hero-img" />
                <div class="position-absolute top-0 start-0 bg-white text-dark rounded-pill px-4 py-3 shadow-sm m-3">
                    🌟 جدیدترین کالکشن
                </div>
            </div>
        </div>
    </div>

    <style>
        .brand-gradient {
            background: linear-gradient(90deg, #6f42c1, #ff6a00 70%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-title {
            font-weight: 900 !important;
            line-height: 1.1;
        }

        /* متن کوچکتر و حرفه‌ای‌تر */
        .hero-subtitle {
            font-size: 1rem; /* کوچکتر از قبل */
            line-height: 1.6;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
            color: #555;
        }

        /* تصویر بزرگ‌تر */
        .hero-img {
            max-height: 580px;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

            .hero-img:hover {
                transform: scale(1.05);
            }

        .btn-right-wrap {
            justify-content: flex-end !important;
        }

        /* فاصله بیشتر با div بعدی */
        .hero-section {
            margin-bottom: 6rem;
        }

        .btn-right-wrap .btn {
            font-size: 1.1rem;
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }
    </style>









<div class="container my-5">
    <div class="promo-banner rounded-4 shadow-lg text-center text-white p-5 position-relative overflow-hidden">
        <h4 class="fw-bold mb-3">🍂 تخفیف ویژه پاییزه</h4>
        <p class="mb-4 fs-5">۲۰٪ تخفیف روی کیف و کفش‌های منتخب فقط تا پایان هفته</p>


        <a asp-page="/Products/Index" asp-route-discounted="true" asp-route-take="10"
           class="btn btn-light btn-lg rounded-pill shadow-sm fw-semibold">
            مشاهده محصولات تخفیف‌دار
        </a>


        <!-- برگ های سفید ریز سمت چپ -->
        <span class="leaf" style="top:5%; left:2%;"></span>
        <span class="leaf" style="top:20%; left:4%;"></span>
        <span class="leaf" style="top:35%; left:1%;"></span>
        <span class="leaf" style="bottom:10%; left:3%;"></span>
        <!-- 56 برگ تصادفی سمت چپ -->
        <script>
            const banner = document.querySelector('.promo-banner');
            for(let i=0; i<56; i++){
                const leaf = document.createElement('span');
                leaf.className = 'leaf';
                const size = Math.random() * 8 + 4;
                leaf.style.width = size + 'px';
                leaf.style.height = size + 'px';
                leaf.style.top = Math.random() * 100 + '%';
                leaf.style.left = Math.random() * 15 + '%'; // سمت چپ
                banner.appendChild(leaf);
            }
            // 60 برگ سمت راست
            for(let i=0; i<60; i++){
                const leaf = document.createElement('span');
                leaf.className = 'leaf';
                const size = Math.random() * 8 + 4;
                leaf.style.width = size + 'px';
                leaf.style.height = size + 'px';
                leaf.style.top = Math.random() * 100 + '%';
                leaf.style.right = Math.random() * 15 + '%'; // سمت راست
                banner.appendChild(leaf);
            }
        </script>

        <!-- برگ های سفید ریز سمت راست -->
        <span class="leaf" style="top:10%; right:3%;"></span>
        <span class="leaf" style="top:25%; right:1%;"></span>
        <span class="leaf" style="bottom:15%; right:2%;"></span>
        <span class="leaf" style="bottom:5%; right:4%;"></span>
    </div>
</div>

<style>
    .promo-banner {
        background: linear-gradient(135deg, #FF7F50, #FFB347, #C15800);
        color: #fff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.25);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .promo-banner:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.8rem 1.5rem rgba(0,0,0,0.25);
        }

        .promo-banner .btn {
            font-weight: 600;
            box-shadow: 0 4px 6px rgba(0,0,0,0.15);
            transition: all 0.3s ease;
        }

            .promo-banner .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 8px rgba(0,0,0,0.2);
            }
    /* برگ سفید ساده (لوگوی برگ) */
    .leaf {
        position: absolute;
        width: 12px;
        height: 12px;
        background-color: #fff;
        clip-path: polygon( 50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35% );
        opacity: 0.7;
    }
</style>



    <!-- سه ویژگی کلیدی (نسخه کارت‌ها) -->
<!-- سه ویژگی کلیدی (نسخه کارت‌ها حرفه‌ای) -->
<div class="row text-center mt-5 g-4">
    <div class="col-md-4">
        <div class="feature-card p-4 bg-light rounded-4 shadow-sm h-100">
            <div class="icon-wrapper mb-3">
                <i class="bi bi-truck fs-1 text-primary"></i>
            </div>
            <h5 class="fw-bold mb-2">ارسال سریع</h5>
            <p class="text-muted small">تحویل فوری درب منزل در سراسر ایران</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card p-4 bg-light rounded-4 shadow-sm h-100">
            <div class="icon-wrapper mb-3">
                <i class="bi bi-shield-check fs-1 text-success"></i>
            </div>
            <h5 class="fw-bold mb-2">ضمانت اصالت</h5>
            <p class="text-muted small">محصولات اورجینال با گارانتی معتبر</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card p-4 bg-light rounded-4 shadow-sm h-100">
            <div class="icon-wrapper mb-3">
                <i class="bi bi-headset fs-1 text-danger"></i>
            </div>
            <h5 class="fw-bold mb-2">پشتیبانی ۲۴ ساعته</h5>
            <p class="text-muted small">پشتیبانی حرفه‌ای در تمام ساعات شبانه‌روز</p>
        </div>
    </div>
</div>

<style>
    /* کارت ویژگی‌ها */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
    }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(0,0,0,0.15);
        }

    /* آیکون‌ها داخل کارت */
    .icon-wrapper {
        width: 70px;
        height: 70px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(13,110,253,0.1), rgba(13,110,253,0.2));
        transition: background 0.3s ease, transform 0.3s ease;
    }

    .feature-card:hover .icon-wrapper {
        transform: scale(1.2);
        background: linear-gradient(135deg, rgba(13,110,253,0.2), rgba(13,110,253,0.3));
    }

    /* عنوان و متن */
    .feature-card h5 {
        font-size: 1.25rem;
    }

    .feature-card p {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

    <!-- دسته‌بندی‌ها -->

<section id="categories" class="mb-5 mt-5 text-center">
    <h2 class="fw-bold mb-4" style="font-size:2rem; color:#0d6efd;">
        <i class="bi bi-tags-fill me-2"></i> دسته‌بندی محصولات
    </h2>
    <div class="d-flex flex-wrap gap-3 justify-content-center align-items-center">
        @foreach (var category in Model.Categories)
        {
            var isActive = string.Equals(Model.SelectedCategory, category, System.StringComparison.OrdinalIgnoreCase);
            <a asp-page="/Index"
               asp-route-SelectedCategory="@category"
               class="btn btn-outline-primary @(isActive ? "active" : "")"
               style="padding:10px 20px; font-size:0.95rem; transition:0.3s;">
                <i class="bi bi-chevron-right me-1"></i> @category
            </a>
        }
    </div>
</section>


    <!-- محصولات -->
    <h2 class="fw-bold mb-4">محصولات پرفروش</h2>
    @if (!Model.Products.Any())
    {
        <div class="alert alert-info text-center py-3">هیچ محصولی موجود نیست.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-card">
                        <img src="@product.ImageUrl" class="card-img-top product-img" alt="@product.Name" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate" title="@product.Name">@product.Name</h5>
                            <p class="card-text text-truncate text-muted small" title="@product.Description">@product.Description</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary">@product.Price.ToString("N0") تومان</span>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-page="/Products/Details"
                                   asp-route-slug="@product.Slug">
                                    مشاهده
                                </a>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 text-center">
                            <span class="badge bg-secondary">@product.Category</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* متن برند با گرادیان */
    .brand-gradient {
        background: linear-gradient(90deg, #6f42c1, #ff6a00 70%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Hero image */
    .hero-img {
        max-height: 420px;
        object-fit: contain;
    }

    /* کارت‌ها */
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }

    /* عکس محصولات */
    .product-img {
        height: 300px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .hover-card:hover .product-img {
        transform: scale(1.08);
    }

    /* دسته‌بندی فعال */
    .btn-outline-primary.active {
        background-color: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
</style>


@{
    // اگر محصولی داریم، دسته بندی اولین محصول پیشنهادی را بگیر
    var categoryFilter = Model.RecommendedProducts != null && Model.RecommendedProducts.Any()
                         ? Model.RecommendedProducts.First().Category
                         : null;

    // لینک دکمه را داینامیک بساز
    var productsUrl = categoryFilter != null
                      ? $"/Products?category={Uri.EscapeDataString(categoryFilter)}"
                      : "/Products";
}

<section class="container my-5 personalized-section text-center">
    <div class="rounded-4 shadow-lg p-5 text-white position-relative overflow-hidden">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-overlay"></div>

        <h2 class="fw-bold display-6 mb-3 position-relative">
            🎯 پیشنهاد اختصاصی برای شما
        </h2>
        <p class="lead mb-4 position-relative">
            براساس محصولاتی که مشاهده کردید، این انتخاب‌ها می‌توانند امضای استایل بعدی شما باشند.
        </p>

        <div class="row justify-content-center g-4 position-relative">
            @foreach (var product in Model.RecommendedProducts.Take(3))
            {
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <img src="@product.ImageUrl" class="card-img-top personalized-img rounded-top-4" alt="@product.Name" />
                        <div class="card-body">
                            <h6 class="fw-bold text-dark">@product.Name</h6>
                            <span class="text-muted small">@product.Category</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 position-relative">
            <a href="@productsUrl"
               class="btn btn-lg px-5 py-3 shadow rounded-pill text-white"
               style="background: linear-gradient(45deg,#ff6a00,#ff0080); border:none;">
                مشاهده همه پیشنهادها
            </a>
        </div>
    </div>
</section>

<style>
    .personalized-section {
        margin-top: 80px;
    }

        .personalized-section .bg-overlay {
            background: linear-gradient(135deg, rgba(1,0,0,0.9), rgba(106,13,173,0.8));
            z-index: 1;
        }

        .personalized-section h2,
        .personalized-section p,
        .personalized-section .row,
        .personalized-section .mt-4 {
            z-index: 2;
        }

        /* فقط تصاویر داخل personalized-section */
        .personalized-section .personalized-img {
            height: 250px; /* ارتفاع ثابت */
            width: 100%; /* پر کردن پهنای کارت */
            object-fit: cover; /* حفظ تناسب و برش مناسب */
            border-top-left-radius: 1rem;
            border-top-right-radius: 1rem;
        }
</style>


